generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum SchoolClass {
  GRADE_6_A
  GRADE_6_B
  GRADE_6_C
  GRADE_7_A
  GRADE_7_B
  GRADE_7_C
}

enum LessonStatus {
  OPEN
  CLOSED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum XpSource {
  ATTENDANCE
  BEHAVIOR
  MANUAL
  BULK
  SYSTEM
  ACTIVITY
  PROFILE_AVATAR
  DEV_COIN_PURCHASE
  DEV_COIN_TRANSFER
}

enum AuditEvent {
  USER_CREATED
  USER_UPDATED
  USER_STATUS_CHANGED
  PASSWORD_RESET
  PASSWORD_CHANGED
  MODERATION_CHANGED
  THEME_CHANGED
  ACTIVITY_CREATED
  ACTIVITY_STATE_CHANGED
  ACTIVITY_GRADED
  NOTIFICATION_CREATED
  DEV_COIN_GRANTED
  DEV_COIN_RATE_CHANGED
  DEV_COIN_TREASURY_CHANGED
  STICKER_ACTIVATED
  STICKER_PACK_PURCHASED
  STICKER_LISTED
  STICKER_TRADED
  STICKER_DONATED
  DEV_COIN_TRANSFERRED
}

enum DevCoinSource {
  PURCHASE
  TEACHER_GRANT
  INITIAL_GRANT
  PROFILE_AVATAR
  STICKER_PACK
  STICKER_MARKET
  PATENT_REWARD
  TRANSFER_SENT
  TRANSFER_RECEIVED
}

enum StickerCollectionState {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum StickerState {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StickerRarity {
  LOW
  MEDIUM
  HIGH
}

enum StickerCopyState {
  TREASURY
  OWNED
  ESCROW
}

enum StickerListingState {
  ACTIVE
  SOLD
  CANCELLED
  EXPIRED
}

enum StickerDonationState {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum PatentRewardState {
  PAID
  PENDING
}

enum TreasuryEntrySource {
  OPENING
  EXISTING_CIRCULATION
  XP_CONVERSION
  PLATFORM_PURCHASE
  MARKET_FEE
  PATENT_REWARD
  TEACHER_DISTRIBUTION
  ADMIN_MINT
  ADMIN_BURN
}

enum AvatarPurchaseCurrency {
  XP
  DEV_COIN
}

enum NotificationKind {
  POPUP
  INBOX
}

enum ActivityType {
  EXTERNAL_LINK
  FORM
  GROUP
}

enum ActivityQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  WRITTEN
}

enum SubmissionStatus {
  SUBMITTED
  AWAITING_REVIEW
  GRADED
}

enum WrittenGrade {
  CORRECT
  INCORRECT
  PARTIAL
}

enum TeamDivisionMode {
  RANDOM
  MANUAL
}

model User {
  id                       String                  @id @default(uuid()) @db.Uuid
  firstName                String
  lastName                 String
  passwordHash             String
  xp                       Int                     @default(0)
  devCoins                 Int                     @default(0)
  accessCode               String                  @unique
  originSchoolClass        SchoolClass?
  status                   UserStatus              @default(ACTIVE)
  role                     Role
  profileAvatar            String                  @default("default")
  sessionVersion           Int                     @default(1)
  mustChangePassword       Boolean                 @default(false)
  lastLoginAt              DateTime?
  lastSeenAt               DateTime?
  deactivatedAt            DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  lessons                  Lesson[]                @relation("TeacherLessons")
  attendances              Attendance[]
  xpEntries                XpEntry[]               @relation("StudentXp")
  authoredXp               XpEntry[]               @relation("XpAuthor")
  behaviors                BehaviorRating[]        @relation("StudentBehavior")
  ratedBehaviors           BehaviorRating[]        @relation("BehaviorTeacher")
  cleanups                 CleanupAssignment[]     @relation("CleanupStudent")
  confirmedCleanups        CleanupAssignment[]     @relation("CleanupTeacher")
  auditActions             AuditLog[]              @relation("AuditActor")
  auditTargets             AuditLog[]              @relation("AuditTarget")
  authoredActivities       Activity[]              @relation("ActivityAuthor")
  activityRecipients       ActivityRecipient[]     @relation("ActivityRecipientStudent")
  activitySubmissions      ActivitySubmission[]
  activityAnswers          ActivityAnswer[]
  activityTeamMemberships  ActivityTeamMember[]
  activityAwards           ActivityAward[]
  lessonParticipations     LessonParticipant[]
  authoredNotifications    Notification[]          @relation("NotificationAuthor")
  notificationReceipts     NotificationReceipt[]
  profileAvatarPurchases   ProfileAvatarPurchase[]
  devCoinEntries           DevCoinEntry[]          @relation("StudentDevCoins")
  authoredDevCoinEntries   DevCoinEntry[]          @relation("DevCoinAuthor")
  stickerCopies            StickerCopy[]           @relation("StickerCopyOwner")
  stickerPackPurchases     StickerPackPurchase[]
  stickerListings          StickerListing[]        @relation("StickerListingSeller")
  stickerPurchases         StickerListing[]        @relation("StickerListingBuyer")
  stickerTradesSold        StickerTrade[]          @relation("StickerTradeSeller")
  stickerTradesBought      StickerTrade[]          @relation("StickerTradeBuyer")
  stickerDonationsSent     StickerDonation[]       @relation("StickerDonationSender")
  stickerDonationsReceived StickerDonation[]       @relation("StickerDonationRecipient")
  patentProgress           StudentPatentProgress?
  patentRewardClaims       PatentRewardClaim[]
  treasuryEntriesAuthored  DevCoinTreasuryEntry[]  @relation("TreasuryEntryAuthor")
  devCoinTransfersSent     DevCoinTransfer[]       @relation("DevCoinTransferSender")
  devCoinTransfersReceived DevCoinTransfer[]       @relation("DevCoinTransferRecipient")

  @@index([role, status, xp])
  @@index([originSchoolClass, status])
}

model ProfileAvatarPurchase {
  id             String                 @id @default(uuid()) @db.Uuid
  studentId      String                 @db.Uuid
  avatarKey      String
  amountPaid     Int
  currency       AvatarPurchaseCurrency @default(XP)
  xpEntryId      String?                @unique @db.Uuid
  devCoinEntryId String?                @unique @db.Uuid
  purchasedAt    DateTime               @default(now())
  student        User                   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  xpEntry        XpEntry?               @relation(fields: [xpEntryId], references: [id], onDelete: Restrict)
  devCoinEntry   DevCoinEntry?          @relation(fields: [devCoinEntryId], references: [id], onDelete: Restrict)

  @@unique([studentId, avatarKey])
  @@index([studentId, purchasedAt])
}

model DevCoinEntry {
  id                    String                 @id @default(uuid()) @db.Uuid
  studentId             String                 @db.Uuid
  authorId              String?                @db.Uuid
  xpEntryId             String?                @unique @db.Uuid
  delta                 Int
  reason                String
  source                DevCoinSource
  idempotencyKey        String                 @unique
  createdAt             DateTime               @default(now())
  student               User                   @relation("StudentDevCoins", fields: [studentId], references: [id], onDelete: Restrict)
  author                User?                  @relation("DevCoinAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  xpEntry               XpEntry?               @relation(fields: [xpEntryId], references: [id], onDelete: Restrict)
  profileAvatarPurchase ProfileAvatarPurchase?
  treasuryEntry         DevCoinTreasuryEntry?
  sentTransfer          DevCoinTransfer?       @relation("DevCoinTransferSenderEntry")
  receivedTransfer      DevCoinTransfer?       @relation("DevCoinTransferRecipientEntry")

  @@index([studentId, createdAt])
}

model DevCoinTransfer {
  id               String       @id @default(uuid()) @db.Uuid
  senderId         String       @db.Uuid
  recipientId      String       @db.Uuid
  senderEntryId    String       @unique @db.Uuid
  recipientEntryId String       @unique @db.Uuid
  xpEntryId        String       @unique @db.Uuid
  amount           Int
  xpFee            Int          @default(5)
  weekKey          String
  idempotencyKey   String       @unique
  createdAt        DateTime     @default(now())
  sender           User         @relation("DevCoinTransferSender", fields: [senderId], references: [id], onDelete: Restrict)
  recipient        User         @relation("DevCoinTransferRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  senderEntry      DevCoinEntry @relation("DevCoinTransferSenderEntry", fields: [senderEntryId], references: [id], onDelete: Restrict)
  recipientEntry   DevCoinEntry @relation("DevCoinTransferRecipientEntry", fields: [recipientEntryId], references: [id], onDelete: Restrict)
  xpEntry          XpEntry      @relation(fields: [xpEntryId], references: [id], onDelete: Restrict)

  @@index([senderId, weekKey, createdAt])
  @@index([recipientId, createdAt])
}

model StickerCollection {
  id           String                 @id @default(uuid()) @db.Uuid
  slug         String                 @unique
  name         String
  state        StickerCollectionState @default(DRAFT)
  activatedAt  DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  stickers     Sticker[]
  patentLevels PatentLevel[]
}

model Sticker {
  id                 String            @id @default(uuid()) @db.Uuid
  collectionId       String            @db.Uuid
  number             Int
  slug               String            @unique
  name               String
  description        String
  alt                String
  imagePath          String
  manifestHash       String
  totalCopies        Int
  rarity             StickerRarity
  score              Int
  state              StickerState      @default(DRAFT)
  publishedAt        DateTime?
  firstDistributedAt DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  collection         StickerCollection @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  copies             StickerCopy[]

  @@unique([collectionId, number])
  @@index([collectionId, state, number])
}

model StickerCopy {
  id             String               @id @default(uuid()) @db.Uuid
  stickerId      String               @db.Uuid
  serial         Int
  ownerId        String?              @db.Uuid
  state          StickerCopyState     @default(TREASURY)
  packPurchaseId String?              @db.Uuid
  acquiredAt     DateTime?
  createdAt      DateTime             @default(now())
  sticker        Sticker              @relation(fields: [stickerId], references: [id], onDelete: Restrict)
  owner          User?                @relation("StickerCopyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  packPurchase   StickerPackPurchase? @relation(fields: [packPurchaseId], references: [id], onDelete: Restrict)
  listings       StickerListing[]
  donations      StickerDonation[]

  @@unique([stickerId, serial])
  @@index([ownerId, state, stickerId])
  @@index([state, stickerId])
}

model StickerPackPurchase {
  id             String        @id @default(uuid()) @db.Uuid
  studentId      String        @db.Uuid
  price          Int
  schoolDay      String
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())
  student        User          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  copies         StickerCopy[]

  @@index([studentId, schoolDay])
}

model StickerListing {
  id        String              @id @default(uuid()) @db.Uuid
  copyId    String              @db.Uuid
  sellerId  String              @db.Uuid
  buyerId   String?             @db.Uuid
  price     Int
  state     StickerListingState @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime            @default(now())
  settledAt DateTime?
  copy      StickerCopy         @relation(fields: [copyId], references: [id], onDelete: Restrict)
  seller    User                @relation("StickerListingSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  buyer     User?               @relation("StickerListingBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  trade     StickerTrade?

  @@index([state, expiresAt])
  @@index([sellerId, state])
}

model StickerTrade {
  id           String         @id @default(uuid()) @db.Uuid
  listingId    String         @unique @db.Uuid
  sellerId     String         @db.Uuid
  buyerId      String         @db.Uuid
  price        Int
  sellerAmount Int
  fee          Int
  createdAt    DateTime       @default(now())
  listing      StickerListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  seller       User           @relation("StickerTradeSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  buyer        User           @relation("StickerTradeBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
}

model StickerDonation {
  id          String               @id @default(uuid()) @db.Uuid
  copyId      String               @db.Uuid
  senderId    String               @db.Uuid
  recipientId String               @db.Uuid
  state       StickerDonationState @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime             @default(now())
  resolvedAt  DateTime?
  copy        StickerCopy          @relation(fields: [copyId], references: [id], onDelete: Restrict)
  sender      User                 @relation("StickerDonationSender", fields: [senderId], references: [id], onDelete: Restrict)
  recipient   User                 @relation("StickerDonationRecipient", fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([recipientId, state, expiresAt])
  @@index([senderId, state])
}

model PatentLevel {
  id            String                  @id @default(uuid()) @db.Uuid
  collectionId  String                  @db.Uuid
  version       Int
  rank          Int
  name          String
  threshold     Int
  xpReward      Int
  devCoinReward Int
  packReward    Int                     @default(0)
  collection    StickerCollection       @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  progress      StudentPatentProgress[]
  rewardClaims  PatentRewardClaim[]

  @@unique([collectionId, version, rank])
}

model StudentPatentProgress {
  id        String       @id @default(uuid()) @db.Uuid
  studentId String       @unique @db.Uuid
  score     Int          @default(0)
  levelId   String?      @db.Uuid
  bestRank  Int          @default(1)
  updatedAt DateTime     @updatedAt
  student   User         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  level     PatentLevel? @relation(fields: [levelId], references: [id], onDelete: Restrict)
}

model PatentRewardClaim {
  id            String            @id @default(uuid()) @db.Uuid
  studentId     String            @db.Uuid
  patentLevelId String            @db.Uuid
  state         PatentRewardState
  xpPaid        Int               @default(0)
  devCoinsPaid  Int               @default(0)
  packPaid      Int               @default(0)
  createdAt     DateTime          @default(now())
  paidAt        DateTime?
  student       User              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  patentLevel   PatentLevel       @relation(fields: [patentLevelId], references: [id], onDelete: Restrict)

  @@unique([studentId, patentLevelId])
}

model DevCoinTreasury {
  id          Int      @id @default(1)
  balance     Int
  totalSupply Int
  updatedAt   DateTime @updatedAt
}

model StickerMarketSetting {
  id        Int      @id @default(1)
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model DevCoinTreasuryEntry {
  id             String              @id @default(uuid()) @db.Uuid
  authorId       String?             @db.Uuid
  devCoinEntryId String?             @unique @db.Uuid
  delta          Int
  reason         String
  source         TreasuryEntrySource
  idempotencyKey String              @unique
  createdAt      DateTime            @default(now())
  author         User?               @relation("TreasuryEntryAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  devCoinEntry   DevCoinEntry?       @relation(fields: [devCoinEntryId], references: [id], onDelete: Restrict)

  @@index([createdAt])
}

model AccessCodeSequence {
  year      Int @id
  nextValue Int @default(1)
}

model Lesson {
  id               String              @id @default(uuid()) @db.Uuid
  title            String
  teacherId        String              @db.Uuid
  status           LessonStatus        @default(OPEN)
  openSlot         String?             @unique
  presenceCodeHash String
  openedAt         DateTime            @default(now())
  closedAt         DateTime?
  teacher          User                @relation("TeacherLessons", fields: [teacherId], references: [id])
  attendances      Attendance[]
  xpEntries        XpEntry[]
  behaviors        BehaviorRating[]
  cleanups         CleanupAssignment[]
  participants     LessonParticipant[]

  @@index([status, openedAt])
}

model LessonParticipant {
  id        String   @id @default(uuid()) @db.Uuid
  lessonId  String   @db.Uuid
  studentId String   @db.Uuid
  createdAt DateTime @default(now())
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([lessonId, studentId])
  @@index([studentId, lessonId])
}

model Attendance {
  id        String           @id @default(uuid()) @db.Uuid
  lessonId  String           @db.Uuid
  studentId String           @db.Uuid
  status    AttendanceStatus @default(PRESENT)
  note      String?
  markedAt  DateTime         @default(now())
  lesson    Lesson           @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  student   User             @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([lessonId, studentId])
}

model XpEntry {
  id                    String                 @id @default(uuid()) @db.Uuid
  studentId             String                 @db.Uuid
  lessonId              String?                @db.Uuid
  authorId              String?                @db.Uuid
  delta                 Int
  reason                String
  source                XpSource
  idempotencyKey        String                 @unique
  createdAt             DateTime               @default(now())
  student               User                   @relation("StudentXp", fields: [studentId], references: [id], onDelete: Restrict)
  lesson                Lesson?                @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  author                User?                  @relation("XpAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  behavior              BehaviorRating?
  activityAwards        ActivityAward[]
  profileAvatarPurchase ProfileAvatarPurchase?
  devCoinEntry          DevCoinEntry?
  devCoinTransfer       DevCoinTransfer?

  @@index([studentId, createdAt])
}

model BehaviorRating {
  id        String   @id @default(uuid()) @db.Uuid
  lessonId  String   @db.Uuid
  studentId String   @db.Uuid
  teacherId String   @db.Uuid
  score     Int
  reason    String?
  xpEntryId String   @unique @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  student   User     @relation("StudentBehavior", fields: [studentId], references: [id], onDelete: Restrict)
  teacher   User     @relation("BehaviorTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  xpEntry   XpEntry  @relation(fields: [xpEntryId], references: [id], onDelete: Restrict)

  @@unique([lessonId, studentId])
}

model CleanupAssignment {
  id          String   @id @default(uuid()) @db.Uuid
  lessonId    String   @db.Uuid
  studentId   String   @db.Uuid
  confirmedBy String   @db.Uuid
  confirmedAt DateTime @default(now())
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  student     User     @relation("CleanupStudent", fields: [studentId], references: [id], onDelete: Restrict)
  teacher     User     @relation("CleanupTeacher", fields: [confirmedBy], references: [id], onDelete: Restrict)

  @@unique([lessonId, studentId])
  @@index([studentId, confirmedAt])
}

model AppSetting {
  id                 Int      @id @default(1)
  studentAreaEnabled Boolean  @default(true)
  accentColor        String   @default("#328fff")
  timeZone           String   @default("America/Fortaleza")
  devCoinsPerXp      Int      @default(1)
  updatedAt          DateTime @updatedAt
}

model Activity {
  id               String               @id @default(uuid()) @db.Uuid
  title            String
  description      String?
  type             ActivityType
  opensAt          DateTime
  closesAt         DateTime
  manuallyClosedAt DateTime?
  externalUrl      String?
  maxXp            Int
  authorId         String               @db.Uuid
  divisionMode     TeamDivisionMode?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  author           User                 @relation("ActivityAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  recipients       ActivityRecipient[]
  questions        ActivityQuestion[]
  submissions      ActivitySubmission[]
  teams            ActivityTeam[]
  awards           ActivityAward[]
  notifications    Notification[]

  @@index([opensAt, closesAt])
  @@index([authorId, createdAt])
}

model Notification {
  id         String                @id @default(uuid()) @db.Uuid
  title      String
  body       String
  kind       NotificationKind
  expiresAt  DateTime?
  linkPath   String?
  authorId   String?               @db.Uuid
  activityId String?               @db.Uuid
  createdAt  DateTime              @default(now())
  author     User?                 @relation("NotificationAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  activity   Activity?             @relation(fields: [activityId], references: [id], onDelete: SetNull)
  receipts   NotificationReceipt[]

  @@index([kind, expiresAt, createdAt])
  @@index([activityId, kind])
}

model NotificationReceipt {
  id               String       @id @default(uuid()) @db.Uuid
  notificationId   String       @db.Uuid
  studentId        String       @db.Uuid
  readAt           DateTime?
  dismissedAt      DateTime?
  lastPopupShownAt DateTime?
  notification     Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  student          User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([notificationId, studentId])
  @@index([studentId, readAt])
}

model ActivityRecipient {
  id                String              @id @default(uuid()) @db.Uuid
  activityId        String              @db.Uuid
  studentId         String              @db.Uuid
  studentSignaledAt DateTime?
  completedAt       DateTime?
  createdAt         DateTime            @default(now())
  activity          Activity            @relation(fields: [activityId], references: [id], onDelete: Cascade)
  student           User                @relation("ActivityRecipientStudent", fields: [studentId], references: [id], onDelete: Restrict)
  submission        ActivitySubmission?
  teamMembership    ActivityTeamMember?
  award             ActivityAward?

  @@unique([activityId, studentId])
  @@index([studentId, createdAt])
}

model ActivityQuestion {
  id         String               @id @default(uuid()) @db.Uuid
  activityId String               @db.Uuid
  prompt     String
  type       ActivityQuestionType
  maxXp      Int
  position   Int
  activity   Activity             @relation(fields: [activityId], references: [id], onDelete: Cascade)
  options    ActivityOption[]
  answers    ActivityAnswer[]

  @@unique([activityId, position])
}

model ActivityOption {
  id         String                 @id @default(uuid()) @db.Uuid
  questionId String                 @db.Uuid
  text       String
  isCorrect  Boolean
  position   Int
  question   ActivityQuestion       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selections ActivityAnswerOption[]

  @@unique([questionId, position])
}

model ActivitySubmission {
  id          String            @id @default(uuid()) @db.Uuid
  activityId  String            @db.Uuid
  recipientId String            @unique @db.Uuid
  studentId   String            @db.Uuid
  status      SubmissionStatus
  submittedAt DateTime          @default(now())
  gradedAt    DateTime?
  activity    Activity          @relation(fields: [activityId], references: [id], onDelete: Restrict)
  recipient   ActivityRecipient @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  student     User              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  answers     ActivityAnswer[]

  @@unique([activityId, studentId])
  @@index([activityId, status])
}

model ActivityAnswer {
  id           String                 @id @default(uuid()) @db.Uuid
  submissionId String                 @db.Uuid
  questionId   String                 @db.Uuid
  studentId    String                 @db.Uuid
  writtenText  String?
  autoCorrect  Boolean?
  writtenGrade WrittenGrade?
  awardedXp    Int?
  comment      String?
  submission   ActivitySubmission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question     ActivityQuestion       @relation(fields: [questionId], references: [id], onDelete: Restrict)
  student      User                   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  selections   ActivityAnswerOption[]

  @@unique([submissionId, questionId])
}

model ActivityAnswerOption {
  answerId String         @db.Uuid
  optionId String         @db.Uuid
  answer   ActivityAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  option   ActivityOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([answerId, optionId])
}

model ActivityTeam {
  id          String               @id @default(uuid()) @db.Uuid
  activityId  String               @db.Uuid
  name        String
  position    Int
  completedAt DateTime?
  activity    Activity             @relation(fields: [activityId], references: [id], onDelete: Cascade)
  members     ActivityTeamMember[]

  @@unique([activityId, position])
}

model ActivityTeamMember {
  id          String            @id @default(uuid()) @db.Uuid
  teamId      String            @db.Uuid
  recipientId String            @unique @db.Uuid
  studentId   String            @db.Uuid
  team        ActivityTeam      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  recipient   ActivityRecipient @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  student     User              @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([teamId, studentId])
}

model ActivityAward {
  id              String            @id @default(uuid()) @db.Uuid
  activityId      String            @db.Uuid
  recipientId     String            @unique @db.Uuid
  studentId       String            @db.Uuid
  awardedXp       Int
  revision        Int               @default(1)
  observation     String?
  latestXpEntryId String            @db.Uuid
  gradedAt        DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  activity        Activity          @relation(fields: [activityId], references: [id], onDelete: Restrict)
  recipient       ActivityRecipient @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  student         User              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  xpEntry         XpEntry           @relation(fields: [latestXpEntryId], references: [id], onDelete: Restrict)

  @@unique([activityId, studentId])
  @@index([studentId, gradedAt])
}

model AuditLog {
  id        String     @id @default(uuid()) @db.Uuid
  actorId   String?    @db.Uuid
  targetId  String?    @db.Uuid
  event     AuditEvent
  details   Json?
  createdAt DateTime   @default(now())
  actor     User?      @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  target    User?      @relation("AuditTarget", fields: [targetId], references: [id], onDelete: SetNull)
}

model RateLimitBucket {
  key       String   @id
  attempts  Int      @default(0)
  windowEnd DateTime
  updatedAt DateTime @updatedAt
}

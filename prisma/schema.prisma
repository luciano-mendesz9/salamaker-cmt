  @@index([ownerId, status, startedAt])
  @@index([guestId, status, startedAt])
  @@index([status, updatedAt])
}

model BattleshipBoard {
  id        String         @id @default(uuid()) @db.Uuid
  roomId    String         @db.Uuid
  studentId String         @db.Uuid
  ships     Json
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  room      BattleshipRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  student   User           @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([roomId, studentId])
  @@index([studentId, createdAt])
}

model BattleshipShot {
  id         String         @id @default(uuid()) @db.Uuid
  roomId     String         @db.Uuid
  attackerId String         @db.Uuid
  defenderId String         @db.Uuid
  actionKey  String         @unique
  sequence   Int
  cell       Int
  hit        Boolean
  sunkShip   String?
  createdAt  DateTime       @default(now())
  room       BattleshipRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  attacker   User           @relation("BattleshipShotAttacker", fields: [attackerId], references: [id], onDelete: Restrict)
  defender   User           @relation("BattleshipShotDefender", fields: [defenderId], references: [id], onDelete: Restrict)

  @@unique([roomId, sequence])
  @@unique([roomId, attackerId, cell])
  @@index([roomId, createdAt])
  @@index([defenderId, createdAt])
}

model SudokuGame {
  id                     String           @id @default(uuid()) @db.Uuid
  studentId              String           @db.Uuid
  difficulty             SudokuDifficulty
  puzzle                 String           @db.VarChar(81)
  solution               String           @db.VarChar(81)
  board                  String           @db.VarChar(81)
  status                 SudokuGameStatus @default(ACTIVE)
  mistakes               Int              @default(0)
  mistakeLimit           Int
  hintsUsed              Int              @default(0)
  extraMistakesPurchased Boolean          @default(false)
  eligibleForRanking     Boolean          @default(true)
  xpReward               Int
  elapsedSeconds         Int?
  humanPlayScore         Int?
  humanPlaySignals       Json?
  completionKey          String?          @unique
  startedAt              DateTime         @default(now())
  completedAt            DateTime?
  updatedAt              DateTime         @updatedAt
  student                User             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  actions                SudokuAction[]

  @@index([studentId, status, startedAt])
  @@index([difficulty, status, eligibleForRanking, elapsedSeconds])
}

model SudokuAction {
  id        String     @id @default(uuid()) @db.Uuid
  gameId    String     @db.Uuid
  actionKey String     @unique
  kind      String
  cell      Int?
  value     Int?
  createdAt DateTime   @default(now())
  game      SudokuGame @relation(fields: [gameId], references: [id], onDelete: Restrict)

  @@index([gameId, createdAt])
}

model LudoRoom {
  id                 String           @id @default(uuid()) @db.Uuid
  code               String           @unique
  creationKey        String           @unique
  ownerId            String           @db.Uuid
  mode               LudoRoomMode
  status             LudoRoomStatus   @default(WAITING)
  wager              Int
  roomFee            Int              @default(50)
  maxPlayers         Int              @default(4)
  botAdvantaged      Boolean?
  escrowBalance      Int              @default(0)
  initialPlayerCount Int?
  currentSeat        Int              @default(0)
  currentRoll        Int?
  consecutiveSixes   Int              @default(0)
  pauseRequestCount  Int              @default(0)
  turnDeadline       DateTime?
  startedAt          DateTime?
  pausedAt           DateTime?
  finishedAt         DateTime?
  cancelledAt        DateTime?
  version            Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  owner              User             @relation("LudoRoomOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  players            LudoPlayer[]
  moves              LudoMove[]
  invitations        LudoInvitation[]

  @@index([status, createdAt])
  @@index([ownerId, status])
}

model LudoPlayer {
  id             String           @id @default(uuid()) @db.Uuid
  roomId         String           @db.Uuid
  studentId      String?          @db.Uuid
  kind           LudoPlayerKind   @default(STUDENT)
  color          LudoColor
  seat           Int
  status         LudoPlayerStatus @default(JOINED)
  pieces         Json             @default("[-1,-1,-1,-1]")
  stake          Int
  payout         Int              @default(0)
  finishPosition Int?
  connected      Boolean          @default(false)
  joinedAt       DateTime         @default(now())
  lastSeenAt     DateTime?
  disconnectedAt DateTime?
  forfeitedAt    DateTime?
  finishedAt     DateTime?
  room           LudoRoom         @relation(fields: [roomId], references: [id], onDelete: Restrict)
  student        User?            @relation("LudoPlayerStudent", fields: [studentId], references: [id], onDelete: Restrict)
  moves          LudoMove[]       @relation("LudoMovePlayer")
  captures       LudoMove[]       @relation("LudoMoveCapturedPlayer")

  @@unique([roomId, seat])
  @@unique([roomId, studentId])
  @@index([studentId, joinedAt])
  @@index([roomId, status, seat])
}

model LudoMove {
  id               String       @id @default(uuid()) @db.Uuid
  roomId           String       @db.Uuid
  playerId         String       @db.Uuid
  capturedPlayerId String?      @db.Uuid
  sequence         Int
  kind             LudoMoveKind
  roll             Int?
  pieceIndex       Int?
  fromPosition     Int?
  toPosition       Int?
  captured         Json?
  autoReason       String?
  createdAt        DateTime     @default(now())
  room             LudoRoom     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  player           LudoPlayer   @relation("LudoMovePlayer", fields: [playerId], references: [id], onDelete: Restrict)
  capturedPlayer   LudoPlayer?  @relation("LudoMoveCapturedPlayer", fields: [capturedPlayerId], references: [id], onDelete: Restrict)

  @@unique([roomId, sequence])
  @@index([roomId, createdAt])
}

model LudoInvitation {
  id          String               @id @default(uuid()) @db.Uuid
  roomId      String               @db.Uuid
  inviterId   String               @db.Uuid
  inviteeId   String               @db.Uuid
  status      LudoInvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime             @default(now())
  respondedAt DateTime?
  room        LudoRoom             @relation(fields: [roomId], references: [id], onDelete: Restrict)
  inviter     User                 @relation("LudoInvitationInviter", fields: [inviterId], references: [id], onDelete: Restrict)
  invitee     User                 @relation("LudoInvitationInvitee", fields: [inviteeId], references: [id], onDelete: Restrict)

  @@index([inviteeId, status, expiresAt])
  @@index([roomId, status])
  @@index([inviterId, inviteeId, createdAt])
}

model LudoInvitationBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  blocker   User     @relation("LudoBlocker", fields: [blockerId], references: [id], onDelete: Restrict)
  blocked   User     @relation("LudoBlocked", fields: [blockedId], references: [id], onDelete: Restrict)

  @@unique([blockerId, blockedId])
  @@index([expiresAt])
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum SchoolClass {
  GRADE_6_A
  GRADE_6_B
  GRADE_6_C
  GRADE_7_A
  GRADE_7_B
  GRADE_7_C
}

enum LessonStatus {
  OPEN
  CLOSED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum XpSource {
  ATTENDANCE
  BEHAVIOR
  MANUAL
  BULK
  SYSTEM
  ACTIVITY
  PROFILE_AVATAR
  DEV_COIN_PURCHASE
  DEV_COIN_TRANSFER
  PONG_RESULT
  TIC_TAC_TOE_RESULT
  SUDOKU_RESULT
  STICKER_COLLECTION_SALE
  LUDO_ROOM
  LUDO_INVITE
  LUDO_RESULT
  LUDO_FORFEIT
  EXTERNAL_CODE
  BATTLESHIP
  INVESTMENT_FEE
}

enum AuditEvent {
  USER_CREATED
  USER_UPDATED
  USER_STATUS_CHANGED
  PASSWORD_RESET
  PASSWORD_CHANGED
  MODERATION_CHANGED
  THEME_CHANGED
  ACTIVITY_CREATED
  ACTIVITY_STATE_CHANGED
  ACTIVITY_GRADED
  NOTIFICATION_CREATED
  DEV_COIN_GRANTED
  DEV_COIN_RATE_CHANGED
  DEV_COIN_TREASURY_CHANGED
  STICKER_ACTIVATED
  STICKER_PACK_PURCHASED
  STICKER_LISTED
  STICKER_TRADED
  STICKER_DONATED
  STICKER_COLLECTION_REQUEST_CREATED
  STICKER_COLLECTION_REQUEST_UPDATED
  STICKER_COLLECTION_OFFERED
  STICKER_COLLECTION_OFFER_WITHDRAWN
  STICKER_COLLECTION_PURCHASED
  STICKER_COLLECTION_REQUEST_CANCELLED
  DEV_COIN_TRANSFERRED
  PONG_ROOM_CREATED
  PONG_JOIN_REQUESTED
  PONG_JOIN_RESPONDED
  PONG_MATCH_STARTED
  PONG_MATCH_FINISHED
  PONG_ROOM_CANCELLED
  TIC_TAC_TOE_ROOM_CREATED
  TIC_TAC_TOE_MATCH_STARTED
  TIC_TAC_TOE_MOVE_PLAYED
  TIC_TAC_TOE_MATCH_FINISHED
  TIC_TAC_TOE_REMATCH_REQUESTED
  TIC_TAC_TOE_ROOM_CANCELLED
  SUDOKU_GAME_STARTED
  SUDOKU_HINT_USED
  SUDOKU_EXTRA_ERRORS_PURCHASED
  SUDOKU_GAME_FINISHED
  LUDO_ROOM_CREATED
  LUDO_ROOM_JOINED
  LUDO_INVITE_SENT
  LUDO_MATCH_STARTED
  LUDO_MATCH_PAUSED
  LUDO_MATCH_FINISHED
  LUDO_PLAYER_FORFEITED
  XP_GRANT_CODE_CREATED
  XP_GRANT_CODE_REDEEMED
  BATTLESHIP_ROOM_CREATED
  BATTLESHIP_MATCH_STARTED
  BATTLESHIP_SHOT_FIRED
  BATTLESHIP_MATCH_FINISHED
  BATTLESHIP_ROOM_CANCELLED
  INVESTMENT_APPLIED
  INVESTMENT_REDEEMED
  INVESTMENT_RESERVE_CHANGED
}

enum DevCoinSource {
  PURCHASE
  TEACHER_GRANT
  INITIAL_GRANT
  PROFILE_AVATAR
  STICKER_PACK
  STICKER_MARKET
  PATENT_REWARD
  TRANSFER_SENT
  TRANSFER_RECEIVED
  PONG_ROOM_FEE
  PONG_WAGER
  PONG_PRIZE
  TIC_TAC_TOE_WAGER
  TIC_TAC_TOE_PRIZE
  SUDOKU_EXTRA_ERRORS
  LUDO_ROOM_FEE
  LUDO_ESCROW
  LUDO_PRIZE
  STUDENT_THEME
  BATTLESHIP_WAGER
  BATTLESHIP_PRIZE
  INVESTMENT_APPLICATION
  INVESTMENT_REDEMPTION
}

enum StickerCollectionState {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum StickerState {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StickerRarity {
  LOW
  MEDIUM
  HIGH
}

enum StickerCopyState {
  TREASURY
  OWNED
  ESCROW
}

enum StickerListingState {
  ACTIVE
  SOLD
  CANCELLED
  EXPIRED
}

enum StickerDonationState {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum TeacherCollectionPurchaseRequestState {
  OPEN
  COMPLETED
  CANCELLED
}

enum TeacherCollectionOfferState {
  ACTIVE
  SELECTED
  NOT_SELECTED
  WITHDRAWN
}

enum PatentRewardState {
  PAID
  PENDING
}

enum TreasuryEntrySource {
  OPENING
  EXISTING_CIRCULATION
  XP_CONVERSION
  PLATFORM_PURCHASE
  MARKET_FEE
  PATENT_REWARD
  TEACHER_DISTRIBUTION
  ADMIN_MINT
  ADMIN_BURN
  PONG_ROOM_FEE
  PONG_MATCH_TAX
  TIC_TAC_TOE_MATCH_TAX
  SUDOKU_EXTRA_ERRORS
  LUDO_ROOM_FEE
  LUDO_SETTLEMENT
  BATTLESHIP_MATCH_TAX
  INVESTMENT_APPLICATION
  INVESTMENT_REDEMPTION
}

enum InvestmentProduct {
  MAKER_SAVINGS
  MAKER_BOND
  MAKER_BOND_PLUS
}

enum InvestmentStatus {
  ACTIVE
  REDEEMED
}

enum InvestmentTransactionType {
  APPLICATION
  REDEMPTION
}

enum InvestmentReserveEntrySource {
  ADMIN_MINT
  ADMIN_BURN
  REDEMPTION_GUARANTEE
}

enum BattleshipRoomStatus {
  WAITING
  ACTIVE
  FINISHED
  CANCELLED
}

enum LudoRoomMode {
  HUMAN
  BOT
}

enum LudoRoomStatus {
  WAITING
  ACTIVE
  PAUSED
  FINISHED
  CANCELLED
}

enum LudoPlayerKind {
  STUDENT
  BOT
}

enum LudoPlayerStatus {
  JOINED
  PLAYING
  FINISHED
  FORFEITED
}

enum LudoColor {
  RED
  GREEN
  YELLOW
  BLUE
}

enum LudoInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum LudoMoveKind {
  ROLL
  MOVE
  AUTO_ROLL
  AUTO_MOVE
  FORFEIT
}

enum TicTacToeRoomStatus {
  WAITING
  ACTIVE
  FINISHED
  CANCELLED
}

enum TicTacToeMark {
  X
  O
}

enum TicTacToeSoloStatus {
  ACTIVE
  FINISHED
}

enum TicTacToeSoloResult {
  HUMAN_WIN
  MACHINE_WIN
  DRAW
}

enum SudokuDifficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
  MASTER
}

enum SudokuGameStatus {
  ACTIVE
  COMPLETED
  FAILED
}

enum AvatarPurchaseCurrency {
  XP
  DEV_COIN
}

enum NotificationKind {
  POPUP
  INBOX
}

enum ActivityType {
  EXTERNAL_LINK
  FORM
  GROUP
}

enum ActivityQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  WRITTEN
}

enum SubmissionStatus {
  SUBMITTED
  AWAITING_REVIEW
  GRADED
}

enum WrittenGrade {
  CORRECT
  INCORRECT
  PARTIAL
}

enum TeamDivisionMode {
  RANDOM
  MANUAL
}

enum PongRoomStatus {
  WAITING
  ACTIVE
  FINISHED
  CANCELLED
}

enum PongPlayerSeat {
  OWNER
  GUEST
}

enum PongPlayerStatus {
  WAITING
  PLAYING
  FINISHED
  FORFEITED
  LEFT
}

enum PongJoinRequestStatus {
  PENDING
  APPROVED
  DECLINED
  EXPIRED
}

enum PongFinishReason {
  SCORE
  DISCONNECTION
  FORFEIT
}

model User {
  id                           String                             @id @default(uuid()) @db.Uuid
  firstName                    String
  lastName                     String
  passwordHash                 String
  xp                           Int                                @default(0)
  devCoins                     Int                                @default(0)
  accessCode                   String                             @unique
  originSchoolClass            SchoolClass?
  status                       UserStatus                         @default(ACTIVE)
  role                         Role
  profileAvatar                String                             @default("default")
  sessionVersion               Int                                @default(1)
  mustChangePassword           Boolean                            @default(false)
  lastLoginAt                  DateTime?
  lastSeenAt                   DateTime?
  deactivatedAt                DateTime?
  createdAt                    DateTime                           @default(now())
  updatedAt                    DateTime                           @updatedAt
  lessons                      Lesson[]                           @relation("TeacherLessons")
  attendances                  Attendance[]
  xpEntries                    XpEntry[]                          @relation("StudentXp")
  authoredXp                   XpEntry[]                          @relation("XpAuthor")
  behaviors                    BehaviorRating[]                   @relation("StudentBehavior")
  ratedBehaviors               BehaviorRating[]                   @relation("BehaviorTeacher")
  cleanups                     CleanupAssignment[]                @relation("CleanupStudent")
  confirmedCleanups            CleanupAssignment[]                @relation("CleanupTeacher")
  auditActions                 AuditLog[]                         @relation("AuditActor")
  auditTargets                 AuditLog[]                         @relation("AuditTarget")
  authoredActivities           Activity[]                         @relation("ActivityAuthor")
  activityRecipients           ActivityRecipient[]                @relation("ActivityRecipientStudent")
  activitySubmissions          ActivitySubmission[]
  activityAnswers              ActivityAnswer[]
  activityTeamMemberships      ActivityTeamMember[]
  activityAwards               ActivityAward[]
  lessonParticipations         LessonParticipant[]
  authoredNotifications        Notification[]                     @relation("NotificationAuthor")
  notificationReceipts         NotificationReceipt[]
  profileAvatarPurchases       ProfileAvatarPurchase[]
  studentThemePurchases        StudentThemePurchase[]
  devCoinEntries               DevCoinEntry[]                     @relation("StudentDevCoins")
  authoredDevCoinEntries       DevCoinEntry[]                     @relation("DevCoinAuthor")
  stickerCopies                StickerCopy[]                      @relation("StickerCopyOwner")
  stickerPackPurchases         StickerPackPurchase[]
  stickerListings              StickerListing[]                   @relation("StickerListingSeller")
  stickerPurchases             StickerListing[]                   @relation("StickerListingBuyer")
  stickerTradesSold            StickerTrade[]                     @relation("StickerTradeSeller")
  stickerTradesBought          StickerTrade[]                     @relation("StickerTradeBuyer")
  stickerDonationsSent         StickerDonation[]                  @relation("StickerDonationSender")
  stickerDonationsReceived     StickerDonation[]                  @relation("StickerDonationRecipient")
  collectionPurchaseRequests   TeacherCollectionPurchaseRequest[] @relation("TeacherCollectionPurchaseTeacher")
  collectionOffers             TeacherCollectionOffer[]           @relation("TeacherCollectionOfferStudent")
  collectionPurchasesAsTeacher TeacherCollectionPurchase[]        @relation("TeacherCollectionPurchaseTeacher")
  collectionPurchasesAsStudent TeacherCollectionPurchase[]        @relation("TeacherCollectionPurchaseStudent")
  patentProgress               StudentPatentProgress?
  patentRewardClaims           PatentRewardClaim[]
  treasuryEntriesAuthored      DevCoinTreasuryEntry[]             @relation("TreasuryEntryAuthor")
  devCoinTransfersSent         DevCoinTransfer[]                  @relation("DevCoinTransferSender")
  devCoinTransfersReceived     DevCoinTransfer[]                  @relation("DevCoinTransferRecipient")
  ownedPongRooms               PongRoom[]                         @relation("PongRoomOwner")
  wonPongRooms                 PongRoom[]                         @relation("PongRoomWinner")
  lostPongRooms                PongRoom[]                         @relation("PongRoomLoser")
  pongPlayers                  PongPlayer[]
  pongJoinRequests             PongJoinRequest[]
  pongPoints                   PongPoint[]
  ownedTicTacToeRooms          TicTacToeRoom[]                    @relation("TicTacToeRoomOwner")
  guestTicTacToeRooms          TicTacToeRoom[]                    @relation("TicTacToeRoomGuest")
  wonTicTacToeRooms            TicTacToeRoom[]                    @relation("TicTacToeRoomWinner")
  wonTicTacToeRounds           TicTacToeRound[]                   @relation("TicTacToeRoundWinner")
  ticTacToeSoloGames           TicTacToeSoloGame[]
  sudokuGames                  SudokuGame[]
  ownedLudoRooms               LudoRoom[]                         @relation("LudoRoomOwner")
  ludoPlayers                  LudoPlayer[]                       @relation("LudoPlayerStudent")
  sentLudoInvitations          LudoInvitation[]                   @relation("LudoInvitationInviter")
  receivedLudoInvitations      LudoInvitation[]                   @relation("LudoInvitationInvitee")
  ludoBlocksCreated            LudoInvitationBlock[]              @relation("LudoBlocker")
  ludoBlocksReceived           LudoInvitationBlock[]              @relation("LudoBlocked")
  createdXpGrantCodes          XpGrantCode[]                      @relation("XpGrantCodeCreator")
  xpGrantRedemptions           XpGrantRedemption[]
  ownedBattleshipRooms         BattleshipRoom[]                   @relation("BattleshipRoomOwner")
  guestBattleshipRooms         BattleshipRoom[]                   @relation("BattleshipRoomGuest")
  battleshipTurns              BattleshipRoom[]                   @relation("BattleshipCurrentTurn")
  wonBattleshipRooms           BattleshipRoom[]                   @relation("BattleshipRoomWinner")
  lostBattleshipRooms          BattleshipRoom[]                   @relation("BattleshipRoomLoser")
  battleshipBoards             BattleshipBoard[]
  battleshipShotsFired         BattleshipShot[]                   @relation("BattleshipShotAttacker")
  battleshipShotsReceived      BattleshipShot[]                   @relation("BattleshipShotDefender")
  investmentPositions          InvestmentPosition[]
  investmentTransactions       InvestmentTransaction[]
  investmentReserveEntries     InvestmentReserveEntry[]           @relation("InvestmentReserveEntryAuthor")

  @@index([role, status, xp])
  @@index([originSchoolClass, status])
}

model ProfileAvatarPurchase {
  id             String                 @id @default(uuid()) @db.Uuid
  studentId      String                 @db.Uuid
  avatarKey      String
  amountPaid     Int
  currency       AvatarPurchaseCurrency @default(XP)
  xpEntryId      String?                @unique @db.Uuid
  devCoinEntryId String?                @unique @db.Uuid
  purchasedAt    DateTime               @default(now())
  student        User                   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  xpEntry        XpEntry?               @relation(fields: [xpEntryId], references: [id], onDelete: Restrict)
  devCoinEntry   DevCoinEntry?          @relation(fields: [devCoinEntryId], references: [id], onDelete: Restrict)

  @@unique([studentId, avatarKey])
  @@index([studentId, purchasedAt])
}

model StudentThemePurchase {
  id             String       @id @default(uuid()) @db.Uuid
  studentId      String       @db.Uuid
  themeKey       String
  amountPaid     Int
  devCoinEntryId String       @unique @db.Uuid
  selectedAt     DateTime?
  purchasedAt    DateTime     @default(now())
  student        User         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  devCoinEntry   DevCoinEntry @relation(fields: [devCoinEntryId], references: [id], onDelete: Restrict)

  @@unique([studentId, themeKey])
  @@index([studentId, selectedAt])
}

model DevCoinEntry {
  id                    String                 @id @default(uuid()) @db.Uuid
  studentId             String                 @db.Uuid
  authorId              String?                @db.Uuid
  xpEntryId             String?                @unique @db.Uuid
  delta                 Int
  reason                String
  source                DevCoinSource
  idempotencyKey        String                 @unique
  createdAt             DateTime               @default(now())
  student               User                   @relation("StudentDevCoins", fields: [studentId], references: [id], onDelete: Restrict)
  author                User?                  @relation("DevCoinAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  xpEntry               XpEntry?               @relation(fields: [xpEntryId], references: [id], onDelete: Restrict)
  profileAvatarPurchase ProfileAvatarPurchase?
  studentThemePurchase  StudentThemePurchase?
  treasuryEntry         DevCoinTreasuryEntry?
  sentTransfer          DevCoinTransfer?       @relation("DevCoinTransferSenderEntry")
  receivedTransfer      DevCoinTransfer?       @relation("DevCoinTransferRecipientEntry")
  investmentTransaction InvestmentTransaction?

  @@index([studentId, createdAt])
}

model DevCoinTransfer {
  id               String       @id @default(uuid()) @db.Uuid
  senderId         String       @db.Uuid
  recipientId      String       @db.Uuid
  senderEntryId    String       @unique @db.Uuid
  recipientEntryId String       @unique @db.Uuid
  xpEntryId        String       @unique @db.Uuid
  amount           Int
  xpFee            Int          @default(5)
  weekKey          String
  idempotencyKey   String       @unique
  createdAt        DateTime     @default(now())
  sender           User         @relation("DevCoinTransferSender", fields: [senderId], references: [id], onDelete: Restrict)
  recipient        User         @relation("DevCoinTransferRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  senderEntry      DevCoinEntry @relation("DevCoinTransferSenderEntry", fields: [senderEntryId], references: [id], onDelete: Restrict)
  recipientEntry   DevCoinEntry @relation("DevCoinTransferRecipientEntry", fields: [recipientEntryId], references: [id], onDelete: Restrict)
  xpEntry          XpEntry      @relation(fields: [xpEntryId], references: [id], onDelete: Restrict)

  @@index([senderId, weekKey, createdAt])
  @@index([recipientId, createdAt])
}

model StickerCollection {
  id               String                             @id @default(uuid()) @db.Uuid
  slug             String                             @unique
  name             String
  state            StickerCollectionState             @default(DRAFT)
  activatedAt      DateTime?
  createdAt        DateTime                           @default(now())
  updatedAt        DateTime                           @updatedAt
  stickers         Sticker[]
  patentLevels     PatentLevel[]
  purchaseRequests TeacherCollectionPurchaseRequest[]
}

model Sticker {
  id                 String            @id @default(uuid()) @db.Uuid
  collectionId       String            @db.Uuid
  number             Int
  slug               String            @unique
  name               String
  description        String
  alt                String
  imagePath          String
  manifestHash       String
  totalCopies        Int
  rarity             StickerRarity
  score              Int
  state              StickerState      @default(DRAFT)
  publishedAt        DateTime?
  firstDistributedAt DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  collection         StickerCollection @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  copies             StickerCopy[]

  @@unique([collectionId, number])
  @@index([collectionId, state, number])
}

model StickerCopy {
  id                    String                       @id @default(uuid()) @db.Uuid
  stickerId             String                       @db.Uuid
  serial                Int
  ownerId               String?                      @db.Uuid
  state                 StickerCopyState             @default(TREASURY)
  packPurchaseId        String?                      @db.Uuid
  acquiredAt            DateTime?
  createdAt             DateTime                     @default(now())
  sticker               Sticker                      @relation(fields: [stickerId], references: [id], onDelete: Restrict)
  owner                 User?                        @relation("StickerCopyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  packPurchase          StickerPackPurchase?         @relation(fields: [packPurchaseId], references: [id], onDelete: Restrict)
  listings              StickerListing[]
  donations             StickerDonation[]
  collectionOfferCopies TeacherCollectionOfferCopy[]

  @@unique([stickerId, serial])
  @@index([ownerId, state, stickerId])
  @@index([state, stickerId])
}

model StickerPackPurchase {
  id             String        @id @default(uuid()) @db.Uuid
  studentId      String        @db.Uuid
  price          Int
  schoolDay      String
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())
  student        User          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  copies         StickerCopy[]

  @@index([studentId, schoolDay])
}

model StickerListing {
  id        String              @id @default(uuid()) @db.Uuid
  copyId    String              @db.Uuid
  sellerId  String              @db.Uuid
  buyerId   String?             @db.Uuid
  price     Int
  state     StickerListingState @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime            @default(now())
  settledAt DateTime?
  copy      StickerCopy         @relation(fields: [copyId], references: [id], onDelete: Restrict)
  seller    User                @relation("StickerListingSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  buyer     User?               @relation("StickerListingBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  trade     StickerTrade?

  @@index([state, expiresAt])
  @@index([sellerId, state])
}

model StickerTrade {
  id           String         @id @default(uuid()) @db.Uuid
  listingId    String         @unique @db.Uuid
  sellerId     String         @db.Uuid
  buyerId      String         @db.Uuid
  price        Int
  sellerAmount Int
  fee          Int
  createdAt    DateTime       @default(now())
  listing      StickerListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  seller       User           @relation("StickerTradeSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  buyer        User           @relation("StickerTradeBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
}

model StickerDonation {
  id          String               @id @default(uuid()) @db.Uuid
  copyId      String               @db.Uuid
  senderId    String               @db.Uuid
  recipientId String               @db.Uuid
  state       StickerDonationState @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime             @default(now())
  resolvedAt  DateTime?
  copy        StickerCopy          @relation(fields: [copyId], references: [id], onDelete: Restrict)
  sender      User                 @relation("StickerDonationSender", fields: [senderId], references: [id], onDelete: Restrict)
  recipient   User                 @relation("StickerDonationRecipient", fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([recipientId, state, expiresAt])
  @@index([senderId, state])
}

model TeacherCollectionPurchaseRequest {
  id             String                                @id @default(uuid()) @db.Uuid
  teacherId      String                                @db.Uuid
  collectionId   String                                @db.Uuid
  notificationId String?                               @unique @db.Uuid
  suggestedXp    Int
  xpAmount       Int
  state          TeacherCollectionPurchaseRequestState @default(OPEN)
  createdAt      DateTime                              @default(now())
  resolvedAt     DateTime?
  teacher        User                                  @relation("TeacherCollectionPurchaseTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  collection     StickerCollection                     @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  notification   Notification?                         @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  offers         TeacherCollectionOffer[]
  purchase       TeacherCollectionPurchase?

  @@index([state, createdAt])
  @@index([collectionId, state])
}

model TeacherCollectionOffer {
  id         String                           @id @default(uuid()) @db.Uuid
  requestId  String                           @db.Uuid
  studentId  String                           @db.Uuid
  state      TeacherCollectionOfferState      @default(ACTIVE)
  createdAt  DateTime                         @default(now())
  resolvedAt DateTime?
  request    TeacherCollectionPurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  student    User                             @relation("TeacherCollectionOfferStudent", fields: [studentId], references: [id], onDelete: Restrict)
  copies     TeacherCollectionOfferCopy[]
  purchase   TeacherCollectionPurchase?

  @@unique([requestId, studentId])
  @@index([requestId, state, createdAt])
  @@index([studentId, state])
}

model TeacherCollectionOfferCopy {
  offerId String                 @db.Uuid
  copyId  String                 @db.Uuid
  offer   TeacherCollectionOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  copy    StickerCopy            @relation(fields: [copyId], references: [id], onDelete: Restrict)

  @@id([offerId, copyId])
}

model TeacherCollectionPurchase {
  id        String                           @id @default(uuid()) @db.Uuid
  requestId String                           @unique @db.Uuid
  offerId   String                           @unique @db.Uuid
  teacherId String                           @db.Uuid
  studentId String                           @db.Uuid
  xpAmount  Int
  xpEntryId String                           @unique @db.Uuid
  createdAt DateTime                         @default(now())
  request   TeacherCollectionPurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  offer     TeacherCollectionOffer           @relation(fields: [offerId], references: [id], onDelete: Restrict)
  teacher   User                             @relation("TeacherCollectionPurchaseTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  student   User                             @relation("TeacherCollectionPurchaseStudent", fields: [studentId], references: [id], onDelete: Restrict)
  xpEntry   XpEntry                          @relation(fields: [xpEntryId], references: [id], onDelete: Restrict)

  @@index([studentId, createdAt])
  @@index([teacherId, createdAt])
}

model PatentLevel {
  id            String                  @id @default(uuid()) @db.Uuid
  collectionId  String                  @db.Uuid
  version       Int
  rank          Int
  name          String
  threshold     Int
  xpReward      Int
  devCoinReward Int
  packReward    Int                     @default(0)
  collection    StickerCollection       @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  progress      StudentPatentProgress[]
  rewardClaims  PatentRewardClaim[]

  @@unique([collectionId, version, rank])
